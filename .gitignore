# Secrets - never commit
.env
*.token
*.secret
# Local bootstrap secrets (GitLab admin token, webhooks, generated links).
# The committed template is scripts/secret/bootstrap.example.sh
scripts/secret/*
!scripts/secret/bootstrap.example.sh
!scripts/secret/.env.secret.example

# Build outputs
back/build/
back/.gradle/
front/node_modules/
front/dist/
front/.angular/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# IaC state
**/.terraform/
*.tfstate
*.tfstate.backup
.gstack/
