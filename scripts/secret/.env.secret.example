# Copy to  scripts/secret/.env.secret  and fill in. NEVER commit the real file.
# Used by scripts/secret/bootstrap.sh (your local, gitignored copy of bootstrap.example.sh).

# GitLab admin token, api scope — used to set CI/CD variables via the API.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_PROJECT=openclassrooms7804126/opc-p6-gerez_une_demarche_devops

# Token with write_repository — lets the pipeline push the GitOps release commit.
# Can be the same value as GITLAB_TOKEN.
GITOPS_PUSH_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Deploy token (read_registry) so Kubernetes can pull the private images.
REGISTRY_USER=gitlab+deploy-token-xxxxx
REGISTRY_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Discord webhooks, one per environment channel.
DISCORD_WEBHOOK_URL_DEV=https://discord.com/api/webhooks/.../...
DISCORD_WEBHOOK_URL_TEST=https://discord.com/api/webhooks/.../...
DISCORD_WEBHOOK_URL_PROD=https://discord.com/api/webhooks/.../...

# Optional overrides.
SONAR_PORT=9000
SONAR_ADMIN_PASS=Orion-demo-2026
